# Copy to .env and edit. Bun loads .env automatically. NEVER commit a real token.

# Port + bind
PORT=3000

# REQUIRED if the port is reachable beyond your own machine.
# Every /api call (except /api/health) then needs:  Authorization: Bearer <token>
# Generate one:  openssl rand -hex 24
MUSETRACK_TOKEN=

# This node's name in the fleet (defaults to the OS hostname)
NODE_NAME=pi-master

# Local AI (default, private, runs on the Pi itself)
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
AI_TIMEOUT_MS=60000

# REAL MUSE IN THE APP — Meta Model API (pay-as-you-go, needs billing)
# 1) Create a developer account at https://dev.meta.ai
# 2) API keys -> Create API key. COPY IT IMMEDIATELY — it is shown only once.
# 3) Put it here (Meta's variable name is MODEL_API_KEY). It lives ONLY in
#    this file on this node — never type it into the web UI or a chat.
# MODEL_API_KEY=
# META_MODEL=muse-spark-1.3
# META_API_BASE=https://api.meta.ai/v1
# To make Muse the default provider for the chat box: AI_PROVIDER=meta
# PRIVACY: do NOT pick a "-contributor" model id (e.g. muse-spark-1.3-contributor)
# unless you accept Meta training on your prompts in exchange for a discount.

# OPTIONAL cloud / OpenAI-compatible provider (only used if you select it)
# Works with OpenAI, OpenRouter, Groq, LM Studio, llama.cpp server, etc.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# DANGER, opt-in only: allow "run <anything>" / "exec <anything>" in the Muse
# dispatch box to execute arbitrary shell commands on this node.
# Leave unset unless this is a private, token-protected, single-user box.
ALLOW_ARBITRARY_SHELL=

# Scheduler tick in ms (default 20000). Lower = more precise, slightly more CPU.
SCHEDULER_TICK_MS=20000
