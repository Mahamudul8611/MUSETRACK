[Unit]
Description=MuseTrack — lightweight Muse AI node manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mshiraj
WorkingDirectory=/home/mshiraj/musetrack
ExecStart=/home/mshiraj/.bun/bin/bun run src/index.ts
Restart=on-failure
RestartSec=5
Environment=PORT=3000
# Set these in /home/mshiraj/musetrack/.env instead of here (Bun loads .env):
# MUSETRACK_TOKEN, NODE_NAME, OLLAMA_MODEL ...

[Install]
WantedBy=multi-user.target
